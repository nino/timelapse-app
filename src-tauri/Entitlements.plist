<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- magick_rust links Homebrew's libMagickWand dynamically. Under the
         hardened runtime, library validation only loads dylibs signed by the
         app's own team, and Homebrew's are not, so without this the app dies
         at launch with a dyld "different Team IDs" error. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
