{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Timelapse App",
  "version": "0.1.3",
  "identifier": "com.timelapse-app.app",
  "build": {
    "beforeDevCommand": "bun run fetch:ffmpeg && bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run fetch:ffmpeg && bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Timelapse App",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_UPDATER_PUBLIC_KEY",
      "endpoints": [
        "https://github.com/nino/timelapse-app/releases/latest/download/latest.json"
      ]
    }
  }
}
