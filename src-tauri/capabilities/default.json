{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "fs:default",
    "fs:allow-watch",
    "fs:allow-unwatch",
    "core:path:default",
    "core:event:default",
    "core:window:allow-start-dragging",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$HOME/Timelapse" },
        { "path": "$HOME/Timelapse/*" },
        { "path": "$HOME/Timelapse/*/*" },
        { "path": "$HOME/Timelapse/.cache" },
        { "path": "$HOME/Timelapse/.cache/*" },
        { "path": "$HOME/Timelapse/.cache/*/*" },
        { "path": "$HOME/Timelapse_dev" },
        { "path": "$HOME/Timelapse_dev/*" },
        { "path": "$HOME/Timelapse_dev/*/*" },
        { "path": "$HOME/Timelapse_dev/.cache" },
        { "path": "$HOME/Timelapse_dev/.cache/*" },
        { "path": "$HOME/Timelapse_dev/.cache/*/*" }
      ]
    }
  ]
}
